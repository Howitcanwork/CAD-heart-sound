# Trained model / stats files are downloaded from Google Drive at runtime
# (they're too large for GitHub) - never commit them by accident.
models/*.keras
models/*.h5
models/*.npz

# Local Streamlit secrets (never commit real secrets/tokens)
.streamlit/secrets.toml

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# OS / editor cruft
.DS_Store
.vscode/
.idea/
